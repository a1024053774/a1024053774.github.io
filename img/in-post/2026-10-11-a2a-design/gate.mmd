flowchart TB
    S["worker 交付<br/>attempt · fence · 提交号"]
    subgraph MECH["机械检查：脚本判对错"]
        direction LR
        C1["身份与版本"] --> C2["路径边界"] --> C3["完成条件命令"] --> C4["红态"] --> C5["规则式检查"] --> C7["提交尾注"]
    end
    C6["独立审查<br/>新开只读会话，结论绑定提交号"]
    M["集成到项目工作分支<br/>验收命令里顺手打分"]
    X["打回<br/>失败摘要写进 worker 窗格，整串重跑"]
    H["同一 attempt 连续 3 次打回<br/>停止自动回写，交执行主控"]

    S --> MECH
    MECH -->|"全过"| C6
    C6 -->|"可合并"| M
    MECH -.->|"任一项不过"| X
    C6 -.->|"需修复"| X
    X -.-> S
    X --> H
